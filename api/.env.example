# Copy to api/.env and fill in. Every setting is optional except the Google ones (needed for Gmail).

# Where the web app is served. Must match the OAuth redirect URI you register with Google:
#   <KOLD_WEB_ORIGIN>/api/gmail/callback
# KOLD_WEB_ORIGIN=https://your-domain   (required for real Google OAuth; must match the registered redirect URI)

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type: Web application)
KOLD_GOOGLE_CLIENT_ID=
KOLD_GOOGLE_CLIENT_SECRET=

# Local open-weight model served by Ollama (no third-party AI API)
KOLD_OLLAMA_URL=http://127.0.0.1:11434
KOLD_LLM_MODEL=qwen3.5:4b

# Safety limits that protect the user's Gmail reputation
KOLD_MAX_COLD_EMAILS_PER_DAY=25
KOLD_MAX_FOLLOWUPS=2

# Web push (optional): python -m scripts.gen_vapid
KOLD_VAPID_PUBLIC_KEY=
KOLD_VAPID_PRIVATE_KEY=
KOLD_VAPID_SUBJECT=mailto:you@example.com

# Change in production
KOLD_SECRET_KEY=change-me
# KOLD_DATABASE_URL=postgresql+psycopg://user:pass@host/kold
